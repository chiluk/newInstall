# /etc/exports: the access control list for filesystems which may be exported
#		to NFS clients.  See exports(5).
#
# NOTE (2026-10-05): synced from live bonus. Network changed 192.168.1.1/24 -> 192.168.0.1/16
# and crossmnt added (so z/backup is visible under /z for NFSv4 clients).
/z	192.168.0.1/16(rw,no_root_squash,no_subtree_check,async,insecure,crossmnt)
# /backup  	192.168.0.1/16(rw,no_root_squash,no_subtree_check,async)
