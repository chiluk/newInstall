# Netplan for bonus — bond0 -> br0 topology (written by ansible, 2026-10-06).
# Replaces the installer's 50-cloud-init.yaml (cloud-init is disabled on this box).
#
# Topology:
#   physical NICs (bond_slaves, see nas.yml vars)
#     -> bond0   active-backup, primary enp2s0 (single-NIC safe: the bond
#               works with one slave and picks up the 2nd automatically when
#               it's enabled in BIOS and this playbook is re-run)
#     -> br0     bridge carrying the LAN address (DHCP, metric 100)
#   LXD (profile eth0 parent=br0) and podman (host/bridged networking) ride
#   br0, so all three stacks egress via the bond.
#
# NOTE: all five NIC names from the installer netplan are declared even though
# four are currently BIOS-disabled (invisible to lspci). netplan/systemd-networkd
# tolerate absent interfaces: the .network files simply wait, and when a NIC
# reappears after a BIOS re-enable + reboot, networkd enslaves it into bond0
# automatically — no OS reconfiguration needed. (Verified: the installer's own
# generated /run/systemd/network/10-netplan-{enp8s0,enp49s0,enp87s0,enp88s0}
# .network files exist today for NICs that aren't present.)
network:
  version: 2
  renderer: networkd

  ethernets:
{% for nic in bond_slaves %}
    {{ nic }}:
      dhcp4: false
      dhcp6: false
{% endfor %}

  bonds:
    bond0:
      interfaces:
{% for nic in bond_slaves %}
        - {{ nic }}
{% endfor %}
      parameters:
        mode: active-backup
        primary: {{ bond_primary }}
        primary-reselect-policy: always
        mii-monitor-interval: 100
      dhcp4: false
      dhcp6: false

  bridges:
    br0:
      interfaces: [bond0]
      dhcp4: true
      dhcp6: false
      dhcp4-overrides:
        route-metric: 100
